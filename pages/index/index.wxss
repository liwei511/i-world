.container.home {
  min-height: 100vh;
  background: linear-gradient(135deg, #43a047 0%, #1b5e20 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.title {
  text-align: center;
  margin-bottom: 80rpx;
}

.title-main {
  display: block;
  font-size: 72rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 4rpx 20rpx rgba(0,0,0,0.2);
  margin-bottom: 20rpx;
}

.title-sub {
  display: block;
  font-size: 32rpx;
  color: rgba(255,255,255,0.8);
}

.intro {
  text-align: center;
  margin-bottom: 100rpx;
}

.intro-line {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
  margin-bottom: 15rpx;
}

.start-btn {
  background: rgba(255,255,255,0.2);
  color: white;
  border: 2rpx solid rgba(255,255,255,0.5);
  border-radius: 50rpx;
  font-size: 36rpx;
  padding: 20rpx 80rpx;
  backdrop-filter: blur(10rpx);
}

.footer {
  position: absolute;
  bottom: 60rpx;
}

.footer text {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
}
