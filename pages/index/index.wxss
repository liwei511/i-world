/* I 的世界 - 首页样式 */
.container {
  width: 100vw;
  height: 100vh;
  position: relative;
}

/* 开始屏幕 */
.start-screen {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.title {
  font-size: 64rpx;
  color: #4a5a3a;
  font-weight: bold;
  margin-bottom: 50rpx;
}

.intro {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  margin-bottom: 80rpx;
}

.intro text {
  font-size: 28rpx;
  color: #5a5a4a;
  line-height: 1.6;
}

.intro .highlight {
  color: #7fbc41;
  font-weight: 500;
  margin-top: 20rpx;
}

.start-btn {
  width: 300rpx;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #7fbc41;
  color: #fff;
  border-radius: 10rpx;
  font-size: 32rpx;
}

/* 游戏画布 */
.game-canvas {
  width: 100%;
  height: calc(100vh - 120rpx);
  transition: opacity 0.3s;
}

/* 底部操作栏 */
.bottom-bar {
  position: bottom;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 120rpx;
  background-color: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.action-btn {
  flex: 1;
  margin: 0 10rpx;
  height: 70rpx;
  line-height: 70rpx;
  background-color: #f0f0e0;
  border-radius: 10rpx;
  font-size: 28rpx;
}

/* 冥想弹窗 */
.meditation-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.meditation-content {
  width: 80vw;
  background-color: rgba(255, 255, 255, 0.95);
  padding: 40rpx;
  border-radius: 16rpx;
}

.meditation-text {
  font-size: 32rpx;
  line-height: 1.8;
  color: #3a3a3a;
  margin-bottom: 40rpx;
  text-align: center;
}

.next-btn {
  width: 200rpx;
  height: 70rpx;
  line-height: 70rpx;
  background-color: #7fbc41;
  color: #fff;
  margin: 0 auto;
  border-radius: 10rpx;
}

/* 通用弹窗蒙层 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.modal-content {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  text-align: center;
}

.question-input {
  width: 100%;
  min-height: 80rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  padding: 15rpx;
  box-sizing: border-box;
  margin-bottom: 30rpx;
  font-size: 28rpx;
}

.submit-btn {
  width: 100%;
  background-color: #7fbc41;
  color: #fff;
  border-radius: 8rpx;
  height: 70rpx;
  line-height: 70rpx;
}

/* 季节选择 */
.season-content {
  width: 80vw;
  max-height: 70vh;
}

.season-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.season-item {
  padding: 20rpx;
  border-radius: 8rpx;
  background-color: #f5f5f0;
}

.season-name {
  font-size: 30rpx;
  font-weight: 500;
}

.season-mood {
  font-size: 24rpx;
  color: #666;
  margin-top: 5rpx;
}

/* 日记 */
.diary-overlay {
  align-items: flex-end;
}

.diary-content {
  width: 90vw;
  max-height: 80vh;
}

.diary-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.diary-stats text {
  font-size: 26rpx;
  color: #555;
}

.diary-list {
  max-height: 50vh;
  margin-bottom: 20rpx;
}

.diary-entry {
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.diary-date {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 5rpx;
}

.diary-question {
  font-size: 28rpx;
  color: #333;
  margin: 5rpx 0;
}

.diary-answer {
  font-size: 26rpx;
  color: #666;
  margin: 5rpx 0;
  padding-left: 10rpx;
  border-left: 3rpx solid #7fbc41;
}

.diary-visit {
  font-size: 26rpx;
  color: #666;
}

.close-btn {
  margin-top: 20rpx;
  width: 100%;
  background-color: #eee;
  border-radius: 8rpx;
}
