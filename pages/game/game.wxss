.container.game {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #e8f5e9;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 20rpx;
  background: rgba(0, 0, 0, 0.1);
  color: white;
  font-size: 24rpx;
}

.game-canvas {
  flex: 1;
  width: 100%;
}

.mood-bar {
  display: flex;
  align-items: center;
  gap: 15rpx;
  padding: 15rpx 20rpx;
  background: rgba(255, 255, 255, 0.9);
}

.mood-bar text {
  font-size: 24rpx;
  color: #333;
}

.mood-progress {
  flex: 1;
  height: 16rpx;
  background: #eee;
  border-radius: 8rpx;
  overflow: hidden;
}

.mood-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease, background 0.5s ease;
}

.dialog-box {
  position: absolute;
  bottom: 120rpx;
  left: 20rpx;
  right: 20rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(10rpx);
}

.dialog-header {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.dialog-content {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 20rpx;
  font-style: italic;
}

.dialog-input {
  display: flex;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.dialog-input input {
  flex: 1;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  padding: 10rpx 15rpx;
  font-size: 28rpx;
}

.send-btn {
  background: #4caf50;
  color: white;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 10rpx 25rpx;
}

.close-btn {
  background: #4caf50;
  color: white;
  border-radius: 50rpx;
  font-size: 28rpx;
}

/* 摇杆 */
.joystick-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: transparent;
}

.joystick-base {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  backdrop-filter: blur(10rpx);
}

.joystick-knob {
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
}
